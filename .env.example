# Choose at least one OpenRouter model with tool calling.
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODELS=["provider/model-id"]
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROVIDER={}

# Optional: pin price ceilings in USD per million tokens for --max-cost-usd.
# MODEL_PRICES_JSON={"provider/model-id":{"input":1.0,"output":5.0}}
# BENCHMARK_MAX_COST_USD=10

# Optional standard HTTP/SOCKS proxy; add local DB to NO_PROXY.
# HTTPS_PROXY=http://proxy.example:8080
# HTTP_PROXY=http://proxy.example:8080
NO_PROXY=127.0.0.1,localhost

# Local disposable PostgreSQL fixture. Change both values if the port is occupied.
SQL_AGENT_V2_POSTGRES_PORT=55433
BENCHMARK_ADMIN_DSN=postgresql://postgres@127.0.0.1:55433/postgres

# Alternative OpenAI-compatible endpoint, used if OPENROUTER_MODELS is blank.
# OPENAI_BASE_URL=https://your-endpoint.example/v1
# OPENAI_MODEL=your-model
# OPENAI_API_KEY=replace-me

# Optional Jev advisor; disabled unless --advisors jev is selected.
JEV_MODEL=typesafe/jev-1.13
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
